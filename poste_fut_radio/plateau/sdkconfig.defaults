# Réglages d'ESP-IDF pour le plateau (pas des chiffres de la machine : ceux-là sont dans
# pi/reglages/pesees.yaml).
CONFIG_IDF_TARGET="esp32c3"
# Fenêtre texte et mises à jour par le câble USB de la carte (USB-Serial-JTAG).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# Horloge de FreeRTOS à 1 ms (attentes courtes).
CONFIG_FREERTOS_HZ=1000
# 80 MHz suffisent et usent moins l'accu.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y
# Programme figé : la carte redémarre (le délai vient de pesees.yaml).
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
# Le pull-up du reed reste branché pendant le sommeil.
CONFIG_ESP_SLEEP_GPIO_ENABLE_INTERNAL_RESISTORS=y
