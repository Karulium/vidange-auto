# Service systemd : démarre le programme du Pi avec le Pi, et le relance s'il plante.
# Installation pas à pas : pi/systeme/installation.md

[Unit]
Description=Vidange automatique : programme du Pi (le chef)
# Pas d'attente du réseau : la machine doit tourner sans lui.
After=local-fs.target
# Relancer sans limite de nombre (le délai RestartSec évite de s'emballer).
StartLimitIntervalSec=0

[Service]
# Le programme dit à systemd quand il est prêt, puis « je vis » toutes les 2 s tant que le chef
# d'orchestre tourne (programme.yaml → fiabilite → chien_de_garde). S'il se tait WatchdogSec
# secondes (programme figé), systemd l'arrête et le relance comme après un plantage.
Type=notify
NotifyAccess=main
WatchdogSec=20
User=vidange
Group=vidange
WorkingDirectory=/opt/vidange-auto/pi
Environment=VIDANGE_REGLAGES=/opt/vidange-auto/pi/reglages
Environment=VIDANGE_ENTREES_SORTIES=/opt/vidange-auto/docs/entrees-sorties.yaml
Environment=VIDANGE_SECRETS=/etc/vidange/secrets.yaml
Environment=VIDANGE_DONNEES=/var/lib/vidange
Environment=PYTHONUNBUFFERED=1
# Crée /var/lib/vidange (journal, registre, photos, copies de secours) pour le compte vidange.
StateDirectory=vidange
ExecStart=/opt/vidange-auto/pi/.venv/bin/vidange
# Plantage : on relance après 5 s.
Restart=on-failure
RestartSec=5
# Code 2 = réglages faux, code 3 = base du registre abîmée : relancer ne servirait à rien,
# on attend que Karulium corrige (le journal dit quoi faire).
RestartPreventExitStatus=2 3
# Code 4 = programme du Pi mis à jour depuis la page web : ce n'est pas une panne, et systemd
# relance aussitôt la nouvelle version.
SuccessExitStatus=4
RestartForceExitStatus=4
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
