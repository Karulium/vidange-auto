# Réglages d'ESP-IDF pour la carte du spray (pas des chiffres de la machine : ceux-là sont dans
# pi/reglages/machine.yaml → spray).
CONFIG_IDF_TARGET="esp32s3"
# Fenêtre texte et mises à jour par le port USB de l'ESP32-S3 (USB-Serial-JTAG).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# Horloge de FreeRTOS à 1 ms (la boucle tourne toutes les ms).
CONFIG_FREERTOS_HZ=1000
# Programme figé : la carte redémarre (le délai vient de machine.yaml).
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
# Le pilote de l'UART dans la mémoire rapide (réponse sans attente).
CONFIG_UART_ISR_IN_IRAM=y
